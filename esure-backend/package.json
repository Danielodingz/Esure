{
  "name": "@esure/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench:stores": "tsx scripts/benchmark-stores.ts",
    "dev": "tsx watch src/server.ts",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reconcile": "tsx scripts/reconcile-fixtures.ts",
    "build": "npm run generate:api-types && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run generate:api-types && tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "ajv": "^8.20.0",
    "fastify": "^5.11.2",
    "pg": "^8.16.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^13.23.0-beta.16",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
