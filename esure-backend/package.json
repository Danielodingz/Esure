{
  "name": "@esure/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./scenarios/*": "./scenarios/*",
    "./scenario-schema": {
      "types": "./dist/scenario-schema.d.ts",
      "default": "./dist/scenario-schema.js"
    },
    "./scenario-schema.js": {
      "types": "./dist/scenario-schema.d.ts",
      "default": "./dist/scenario-schema.js"
    },
    "./scenario-loader": {
      "types": "./dist/scenario-loader.d.ts",
      "default": "./dist/scenario-loader.js"
    },
    "./scenario-loader.js": {
      "types": "./dist/scenario-loader.d.ts",
      "default": "./dist/scenario-loader.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    },
    "./scenarios.js": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    },
    "./stellar-gateway": {
      "types": "./dist/stellar-gateway.d.ts",
      "default": "./dist/stellar-gateway.js"
    },
    "./stellar-gateway.js": {
      "types": "./dist/stellar-gateway.d.ts",
      "default": "./dist/stellar-gateway.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./domain.js": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./src/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "scenarios"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench:stores": "tsx scripts/benchmark-stores.ts",
    "dev": "tsx watch src/server.ts",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate-status.ts",
    "db:reconcile": "tsx scripts/reconcile-fixtures.ts",
    "db:reconcile:dry-run": "tsx scripts/reconcile-fixtures.ts --dry-run",
    "build": "npm run generate:api-types && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run generate:api-types && tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "ajv": "^8.20.0",
    "fastify": "^5.11.2",
    "pg": "^8.16.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^13.23.0-beta.16",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
